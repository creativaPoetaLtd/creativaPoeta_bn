MONGO_URI=
# Independent credentials used only by protected maintenance paths.
MONGO_PURGE_URI=
MONGO_MIGRATION_URI=
MONGO_AUTO_INDEX=false
MONGO_ENFORCE_SAFE_RUNTIME_ROLE=true
PORT=
JWT_SECRET=
# Exactly 32 random bytes encoded as Base64. Used only to encrypt MFA secrets
# and protect one-time recovery codes. Never expose it in the frontend.
MFA_ENCRYPTION_KEY_BASE64=
SECURITY_RATE_LIMIT_SALT=replace-with-a-different-long-random-secret
ADMIN_BOOTSTRAP_SECRET=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Explicit recipient for every administrative/form notification.
# This is never inferred from the SMTP login or sender address.
ADMIN_NOTIFICATION_EMAIL=creativapoeta@gmail.com

# Primary outbound mailbox (recommended for production).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=contact@creativapoeta.com
SMTP_FROM_NAME=Creativa Poeta
REPLY_TO_EMAIL=contact@creativapoeta.com

# Legacy Gmail transport fallback. Leave unset when SMTP_* is configured.
EMAIL_USER=
EMAIL_PASS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Secret Netlify/Vercel build hook used after blog publication changes.
FRONTEND_BUILD_HOOK_URL=
FRONTEND_BUILD_HOOK_TIMEOUT_MS=10000
FRONTEND_URL=https://creativapoeta.com
REFERRAL_RATE_LIMIT_SALT=replace-with-a-long-random-secret

# Privacy-safe first-party website analytics.
ANALYTICS_RETENTION_DAYS=395
ANALYTICS_ALLOWED_ORIGINS=https://creativapoeta.com,https://www.creativapoeta.com,https://be.creativapoeta.com,https://fr.creativapoeta.com,https://rw.creativapoeta.com,https://nl.creativapoeta.com

# Google Search Console read-only integration. Add the service-account email as
# a user on every listed Search Console property. Prefer a base64-encoded key
# in hosting environment variables to preserve line breaks safely.
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
GSC_SITE_URLS=sc-domain:creativapoeta.com,sc-domain:creativapoeta.be
GSC_CACHE_MINUTES=360

# Secret used by an external uptime/cron monitor to call /api/health/monitor.
ANALYTICS_MONITOR_SECRET=
CRON_SECRET=

# Official Meta WhatsApp Business Cloud API team inbox.
# Never expose these values in the frontend. The webhook URL is:
# https://YOUR_BACKEND/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0

# Approved Meta message templates used when a referral applicant prefers
# WhatsApp. Template names are not secrets. Parameter order is documented in
# WHATSAPP_SETUP.md.
WHATSAPP_REFERRAL_APPROVED_TEMPLATE=cp_referral_application_approved
WHATSAPP_REFERRAL_REJECTED_TEMPLATE=cp_referral_application_rejected
WHATSAPP_TEMPLATE_LANGUAGE_EN=en
WHATSAPP_TEMPLATE_LANGUAGE_FR=fr
WHATSAPP_TEMPLATE_LANGUAGE_NL=nl
WHATSAPP_TEMPLATE_LANGUAGE_RW=rw_RW

# Backup-host variables: never configure these in the public frontend. The
# read-only URI should normally exist only on the protected backup computer.
MONGO_BACKUP_URI=
CP_MONGO_BACKUP_DIR=
CP_MONGO_BACKUP_RETENTION_DAYS=35
# Generate exactly 64 random bytes and store the Base64 value only on the
# protected backup computer. Losing this key makes encrypted backups unusable.
CP_MONGO_BACKUP_ENCRYPTION_KEY_BASE64=
# Optional explicit directory containing mongodump.exe and mongorestore.exe.
CP_MONGODB_TOOLS_BIN=
MONGO_RESTORE_TEST_URI=
MONGO_RESTORE_TEST_USERNAME=
MONGO_RESTORE_TEST_PASSWORD=
CONFIRM_ISOLATED_RESTORE=no
